@startuml
skinparam rankdir TB
skinparam nodesep 20
skinparam ranksep 30
skinparam packageStyle rectangle

package "שכבת הממשק (UI Layer)" {
    class VerticalLayout <<Layout>> #LightBlue

    ' הגדרת העמודות הנסתרות כדי למנוע רוחב
    class LoginView
    class AdminDashboardView
    class UserDashboardView
    class AlgorithmRunnerView
    class CreateOrderView
    class HomeView
    class SavedRoutsView
    class RegisterView
    class UserDetailsView
    class MyOrdersView
    class AdminManagmentView

    ' ירושה מה-Layout (זה מה שגורם להם להופיע מתחתיו)
    LoginView -up-|> VerticalLayout
    AdminDashboardView -up-|> VerticalLayout
    UserDashboardView -up-|> VerticalLayout
    AlgorithmRunnerView -up-|> VerticalLayout
    CreateOrderView -up-|> VerticalLayout
    HomeView -up-|> VerticalLayout
    SavedRoutsView -up-|> VerticalLayout
    RegisterView -up-|> VerticalLayout
    UserDetailsView -up-|> VerticalLayout
    MyOrdersView -up-|> VerticalLayout
    AdminManagmentView -up-|> VerticalLayout

    package "(Components)" {
        class GoogleMapComponent
    }

    AlgorithmRunnerView --> GoogleMapComponent

    ' יצירת מבנה של עמודות בעזרת קשרים שקופים
    LoginView -[hidden]down- CreateOrderView
    CreateOrderView -[hidden]down- SavedRoutsView
    SavedRoutsView -[hidden]down- UserDetailsView

    AdminDashboardView -[hidden]down- HomeView
    HomeView -[hidden]down- RegisterView
    RegisterView -[hidden]down- MyOrdersView

    UserDashboardView -[hidden]down- AlgorithmRunnerView
    AlgorithmRunnerView -[hidden]down- AdminManagmentView
}

@enduml